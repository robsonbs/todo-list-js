# Imagem oficial do Playwright: já traz os navegadores e as
# dependências de sistema necessárias (nada é instalado na máquina local).
FROM mcr.microsoft.com/playwright:v1.48.0-jammy

WORKDIR /app

# Copia a configuração e os testes E2E.
COPY playwright.config.js ./
COPY tests/e2e ./tests/e2e

# Instala a mesma versão do Playwright presente na imagem,
# evitando incompatibilidade entre a CLI e os navegadores.
COPY package.json ./
RUN npm install --no-save @playwright/test@1.48.0

# O container apenas executa os testes; ele não serve a aplicação
# (quem serve é o serviço "servidor" do docker-compose).
CMD ["npx", "playwright", "test", "--project=chromium"]
