# Copie este arquivo para .env para desenvolver localmente.
# Estes valores servem somente para o banco local do Docker Compose.
NODE_ENV=development
PORT=3000
DATABASE_URL=postgres://todo_dev:todo_dev_local_only@localhost:5433/todo_web
POSTGRES_DB=todo_web
POSTGRES_USER=todo_dev
POSTGRES_PASSWORD=todo_dev_local_only
POSTGRES_PORT=5433
SESSION_SECRET=dev-only-secret-substitua-antes-de-publicar-1234567890
CSRF_SECRET=dev-only-csrf-substitua-antes-de-publicar-1234567890
EMAIL_MODE=console
PUBLIC_URL=http://localhost:3000
TRUST_PROXY_HOPS=0
# Para envio real de e-mail, configure EMAIL_MODE=smtp e estas variáveis.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=Lista de Tarefas <nao-responda@example.com>
