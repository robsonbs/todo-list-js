{
  "name": "todo-list-js",
  "version": "1.0.0",
  "type": "module",
  "description": "Lista de Tarefas educacional em HTML/CSS/JS puro",
  "private": true,
  "devDependencies": {
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "@eslint/js": "^10.0.1",
    "eslint": "^10.14.0",
    "globals": "^15.0.0",
    "happy-dom": "^15.0.0",
    "prettier": "^3.9.10",
    "vitest": "^5.1.0"
  },
  "scripts": {
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "docker compose up --build --abort-on-container-exit --exit-code-from playwright playwright",
    "test:e2e:headed": "docker compose run --rm --service-ports playwright npx playwright test --project=chromium --headed",
    "verify": "npm run lint && npm run format:check && npm test"
  }
}
